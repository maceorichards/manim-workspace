{
  // VS Code and Cursor find .venv on their own (bin/ on macOS/Linux, Scripts\ on Windows).
  // Manim Notebook types `manimgl ...` into the integrated terminal, so .venv must be active there.
  "python.terminal.activateEnvironment": true,
  "manim-notebook.autoreload": true,
  // Give venv activation time to finish before the extension sends its command.
  "manim-notebook.delayNewTerminal": 500,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true
  }
}
